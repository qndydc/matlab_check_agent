# Windows Docker Desktop 部署配置。复制为项目根目录的 .env 后再执行 docker compose。
# Windows 路径建议使用正斜杠并保留双引号，例如 D:/MATLAB/projects。
MATLAB_PROJECTS_PATH=D:/MATLAB/projects
MATLAB_DATA_PATH=D:/MATLAB/matlab-atlas-data

# 仅本机访问使用 127.0.0.1；需要局域网访问时改为 0.0.0.0，并配置防火墙。
MATLAB_BIND_ADDRESS=127.0.0.1
MATLAB_WEB_PORT=8000

# 普通调用图不需要 LLM。需要三级语义注释时再填写真实密钥。
DEEPSEEK_API_KEY=
MATLAB_REFACTOR_LLM_BASE_URL=https://api.deepseek.com
MATLAB_REFACTOR_LLM_MODEL=deepseek-v4-pro
