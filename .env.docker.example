# Docker Desktop 或 Linux 部署配置。复制为项目根目录的 .env 后再执行 docker compose。
# 用户项目通过网页上传，主服务器不需要访问客户端路径。
MATLAB_DATA_PATH=./var/docker-data

# 局域网访问使用 0.0.0.0；仅本机访问时改为 127.0.0.1。
# 请同时在主机防火墙中只允许可信内网网段访问这两个端口。
MATLAB_BIND_ADDRESS=0.0.0.0
MATLAB_WEB_PORT=8000
MATLAB_MIGRATION_WEB_PORT=8001

# 首次部署请将 admin 改为真实管理员工号。
MATLAB_REQUIRE_EMPLOYEE_ID=1
MATLAB_ADMIN_EMPLOYEE_IDS=admin

# 父流程和全局重任务并发上限。
MATLAB_ACTIVE_JOBS=16
MATLAB_GLOBAL_WORKERS=8
MATLAB_GLOBAL_PENDING=16

# 上传、解压和每用户存储限制（字节）。
MATLAB_MAX_UPLOAD_BYTES=2147483648
MATLAB_MAX_UNPACKED_BYTES=5368709120
MATLAB_MAX_PROJECT_FILES=100000
MATLAB_USER_QUOTA_BYTES=10737418240

# 模型 URL、名称、密钥和运行参数请在应用右上角“设置”中填写。
# 它们会持久化到 MATLAB_DATA_PATH/config/.env，不会作为容器进程变量锁死。
