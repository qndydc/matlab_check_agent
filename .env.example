# MATLAB Refactor Agent 环境配置模板
# 复制为 .env 后按需修改；.env 已被 Git 忽略，请勿提交真实密钥。
# 配置优先级：进程环境变量 > .env > 代码默认值。
# 相对路径以运行 matlab-refactor 时的当前目录为基准。
# 两个网页右上角“设置”可修改模型/URL/密钥及常用 LLM 参数，下次任务/续跑生效。
# 已由启动进程环境覆盖的字段在网页只读；目录/数据库仍在这里修改后重启。

# 输入 MATLAB 项目。scan/analyze/annotate/migrate 未传 project 时使用此路径。
MATLAB_REFACTOR_INPUT_PATH=tests/fixtures/matlab_projects/basic

# 依赖图输出目录；迁移代码位于 ARTIFACT_DIR/<Job ID>/generated-python。
MATLAB_REFACTOR_GRAPH_OUTPUT_DIR=var/graphs

# analyze 未显式传 --graph-json/--mermaid 时，是否自动输出两类图。
MATLAB_REFACTOR_AUTO_EXPORT_GRAPHS=true

# Job artifact、状态审计数据库和语义 Web 历史库。
# WCC 断点是 Job 内的 migration-checkpoint.json + migration-state.json。
MATLAB_REFACTOR_ARTIFACT_DIR=var/jobs
MATLAB_REFACTOR_STATE_DB=var/refactor-agent.db
MATLAB_REFACTOR_WEB_DB=var/web-projects.db

# 扫描排除规则和人工指定入口点。列表必须是 JSON 数组。
MATLAB_REFACTOR_EXCLUDE_PATTERNS=[".git", "slprj", "build"]
MATLAB_REFACTOR_ENTRY_POINTS=[]

# 确定性 Worker 并发和解析分块。
MATLAB_REFACTOR_MAX_WORKERS=4
MATLAB_REFACTOR_PARSER_CHUNK_SIZE=100

# LLM/ActChunk 并发、WCC 串行上限、普通语义工作单元目标预算和函数数质量阈值。
MATLAB_REFACTOR_MAX_AGENTS=4
MATLAB_REFACTOR_SEMANTIC_MAX_AGENTS=4
MATLAB_REFACTOR_MIGRATION_MAX_AGENTS=1
MATLAB_REFACTOR_MIGRATION_CHUNK_MAX_AGENTS=4
MATLAB_REFACTOR_SEMANTIC_TOKEN_BUDGET=32768
MATLAB_REFACTOR_SEMANTIC_MAX_FUNCTIONS_PER_UNIT=8
MATLAB_REFACTOR_SEMANTIC_CONFIDENCE_THRESHOLD=0.6
MATLAB_REFACTOR_SEMANTIC_MAX_ATTEMPTS=2

# DeepSeek / OpenAI-compatible LLM。真实 Key 只填写在本地 .env。
#你的api key
DEEPSEEK_API_KEY=
MATLAB_REFACTOR_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# URL
MATLAB_REFACTOR_LLM_BASE_URL=https://api.deepseek.com
#模型名称
MATLAB_REFACTOR_LLM_MODEL=deepseek-v4-pro
MATLAB_REFACTOR_LLM_TIMEOUT_SECONDS=120
MATLAB_REFACTOR_LLM_HARD_TIMEOUT_SECONDS=180
MATLAB_REFACTOR_LLM_SDK_MAX_RETRIES=2
MATLAB_REFACTOR_LLM_RESPONSE_RETRIES=2
# 注释需要保持函数链语义完整；代码转换需要返回更长的完整源码 JSON。
MATLAB_REFACTOR_SEMANTIC_MAX_OUTPUT_TOKENS=16384
MATLAB_REFACTOR_MIGRATION_MAX_OUTPUT_TOKENS=32768
MATLAB_REFACTOR_MIGRATION_REASON_MAX_OUTPUT_TOKENS=4096
# 必须按实际模型填写；安全校验会同时预留最大输出和额外余量。
MATLAB_REFACTOR_LLM_CONTEXT_WINDOW_TOKENS=1000000
MATLAB_REFACTOR_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=8192
MATLAB_REFACTOR_LLM_TEMPERATURE=0.1
MATLAB_REFACTOR_LLM_THINKING_MODE=enabled

# 日志。INFO 输出短阶段摘要；WARNING 只保留警告和错误。
MATLAB_REFACTOR_LOG_LEVEL=INFO
MATLAB_REFACTOR_LOG_FORMAT=console
# Agent/模型详细调试日志总开关；只输出流程、计数和错误摘要，不输出 API Key。
DEBUG_MODEL=True
